{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@capacity-api/*": ["./data-quality/capacity/api/_lib/*"]
    }
  },
  "include": ["next-env.d.ts", "data-quality/**/*.ts", "data-quality/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "data-quality/migration-package", "data-quality/capacity"]
}
