# Copy this file to .env.local ON THE SERVER (PuTTY), then edit credentials.
# Do not commit real passwords.

STANDALONE=false
DATA_BACKEND=mariadb
DB_HOST=your-mariadb-host
DB_PORT=3306
DB_NAME=mis_ph_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_POOL_SIZE=10

# Port the app listens on. Must match proxy_pass in the Nginx config — if they
# disagree, Nginx has nothing to talk to and every page returns 502 Bad Gateway.
PORT=3000

# HTTP internal server: leave false / unset. HTTPS only: set true.
# Set true when Nginx terminates TLS, so cookies are only sent over HTTPS.
COOKIE_SECURE=false
